<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frame"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/counter_initial_value"
        android:textColor="@color/text_gray"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="187dp"
        tools:layout_editor_absoluteY="88dp" />

    <ImageView
        android:id="@+id/image_artwork"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@color/frame"
        android:contentDescription="@string/artwork_image_description"
        android:onClick="openDetails"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/artwork_1"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="205dp" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_1"
        android:textColor="@color/text_dark"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="145dp"
        tools:layout_editor_absoluteY="24dp" />

    <TextView
        android:id="@+id/text_artist_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/artist_1"
        android:textColor="@color/text_gray"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="141dp"
        tools:layout_editor_absoluteY="134dp" />

    <Button
        android:id="@+id/button_previous"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_weight="1"
        android:backgroundTint="@color/colorPrimary"
        android:onClick="showPrevious"
        android:text="@string/button_previous"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="614dp" />

    <Button
        android:id="@+id/button_next"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="45dp"
        android:layout_weight="1"
        android:backgroundTint="@color/colorPrimary"
        android:onClick="showNext"
        android:text="@string/button_next"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="614dp" />


</androidx.constraintlayout.widget.ConstraintLayout>

