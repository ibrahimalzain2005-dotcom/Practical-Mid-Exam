<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/frame"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/text_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="164dp"
        android:text="@string/details_header"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_details_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="470dp"
        tools:layout_editor_absoluteY="338dp" />

    <TextView
        android:id="@+id/text_details_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray"
        android:textSize="18sp"
        tools:layout_editor_absoluteX="459dp"
        tools:layout_editor_absoluteY="457dp" />

    <TextView
        android:id="@+id/text_details_year"
        android:layout_width="83dp"
        android:layout_height="15dp"
        android:textColor="@color/text_gray"
        android:textSize="18sp"
        tools:layout_editor_absoluteX="439dp"
        tools:layout_editor_absoluteY="614dp" />

    <Button
        android:id="@+id/button_visit_website"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:backgroundTint="@color/colorAccent"
        android:onClick="visitWebsite"
        android:textSize="50sp"

        android:text="@string/button_visit_website"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="1324dp" />

    <Button
        android:id="@+id/button_back"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:backgroundTint="@color/colorPrimary"
        android:onClick="goBack"
        android:text="@string/button_back"
        android:textColor="@android:color/white"
        android:textSize="50sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="1484dp" />


</androidx.constraintlayout.widget.ConstraintLayout>



